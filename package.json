{
  "name": "shards-inc-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-legal-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests proxy.ts next.config.ts vitest.config.ts playwright.config.ts --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "claims:check": "node scripts/claims-lint.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "next": "16.4.5",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/bundle-analyzer": "16.4.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
